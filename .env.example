[TEMPLATE]
# Copy this file to .env (project root, one level above app/), then replace
# every value before starting. Keep it private: chmod 600 .env
# Generate values with:  openssl rand -base64 24   (admin password)
#                       openssl rand -base64 48   (session secret)

# --- Web UI ---
APP_PORT=9999
# Login for the web UI. ADMIN_PASSWORD must be at least 16 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Cookie signing secret, at least 32 characters.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Set to true only when serving the UI over HTTPS.
SESSION_SECURE=false

# --- SSH ---
# SSH key directory (default ~/.ssh). Profiles reference key filenames inside
# this directory; keys never have to be copied. In Docker this is mounted
# read-only at /run/ssh-keys.
# KEY_DIR=/home/youruser/.ssh
# Trusted SSH host keys (default: <key dir>/known_hosts). Populate once per
# new host with:  ssh-keyscan -p PORT host >> $KNOWN_HOSTS_FILE
# KNOWN_HOSTS_FILE=/home/youruser/.ssh/known_hosts
# OpenSSH client binary (default: ssh).
# SSH_BIN=/usr/bin/ssh

# --- Optional hardening (keep restrictive in production) ---
# Comma-separated allowlists. Empty/unset = allow all.
# ALLOWED_SSH_HOSTS=bastion.example.com,10.20.0.10
# ALLOWED_REMOTE_TARGETS=db.internal.example.com,10.20.0.25

# --- Storage ---
# Where tunnels.sqlite is stored (default ./data).
# DATA_DIR=/path/to/ssh-tunnel-manager-web/data
