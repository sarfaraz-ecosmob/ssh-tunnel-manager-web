# Replace every value before starting. Use a long, unique password and random session secret.
APP_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Optional comma-separated allowlists. Keep these restrictive in production.
# ALLOWED_SSH_HOSTS=bastion.example.com,10.20.0.10
# ALLOWED_REMOTE_TARGETS=db.internal.example.com,10.20.0.25
SESSION_SECURE=false
# SSH key directory and known_hosts file used for tunnels (defaults:
# ~/.ssh and <key dir>/known_hosts). Point KEY_DIR at your real SSH
# directory so keys do not have to be copied.
# KEY_DIR=/home/youruser/.ssh
# KNOWN_HOSTS_FILE=/home/youruser/.ssh/known_hosts
